{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evopilot-real-host-acceptance-manifest/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "target",
    "requiredExtensions",
    "coverage",
    "hostExecutionPolicy",
    "executionOrder",
    "prohibitedEffects",
    "authority"
  ],
  "properties": {
    "schema": { "const": "evopilot-real-host-acceptance-manifest/v3" },
    "id": { "type": "string", "minLength": 1 },
    "target": { "type": "object" },
    "requiredExtensions": { "type": "object" },
    "coverage": { "type": "object" },
    "hostExecutionPolicy": { "type": "object" },
    "executionOrder": { "type": "array", "minItems": 1 },
    "prohibitedEffects": { "type": "array", "minItems": 1 },
    "authority": { "type": "object" }
  }
}
