{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/business-decision-view-v1.schema.json",
  "type": "object",
  "required": ["schema", "viewId", "template", "informationArchitecture", "stage", "sessionId", "sessionDigest", "subject", "title", "summary", "taskNavigation", "risk", "sections", "sourceReasoningMap", "professionalAnalysis", "architectureAssessment", "sourceOutcomeExplanation", "evolutionContext", "hostBoundaryContract", "decisionRelevantFields", "decision", "allowedNextOperations", "authority", "businessViewDigest", "renderedBusinessViewDigest", "canonicalMarkdown"],
  "properties": {
    "schema": { "const": "evopilot-harness-business-decision-view/v1" },
    "template": { "type": "object", "required": ["schema", "id", "version", "locale", "sectionOrder", "templateDigest"], "properties": { "schema": { "const": "evopilot-harness-business-presentation/v2" }, "id": { "type": "string", "minLength": 1 }, "version": { "const": 2 }, "locale": { "enum": ["zh-CN", "en"] }, "sectionOrder": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "templateDigest": { "$ref": "#/$defs/digest" } } },
    "informationArchitecture": { "type": "object", "required": ["primary", "secondary", "audit"], "properties": { "primary": { "const": "business" }, "secondary": { "const": "professional-detail" }, "audit": { "const": "compliance-audit-envelope" } } },
    "viewId": { "type": "string", "minLength": 8 },
    "stage": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 6 },
    "sessionDigest": { "$ref": "#/$defs/digest" },
    "subject": { "type": "object" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "taskNavigation": { "type": "object", "required": ["completed", "current", "remaining", "stopReason", "summary"] },
    "risk": { "type": "object", "required": ["tier", "label", "reason"], "properties": { "tier": { "enum": ["R0", "R1", "R2", "R3"] } } },
    "sections": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "title", "content"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 } } } },
    "sourceReasoningMap": { "type": "object" },
    "professionalAnalysis": { "type": ["object", "null"] },
    "architectureAssessment": { "type": ["object", "null"] },
    "sourceOutcomeExplanation": { "type": ["object", "null"] },
    "evolutionContext": { "type": "object" },
    "hostBoundaryContract": { "type": "object" },
    "decisionRelevantFields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "decision": { "type": ["object", "null"] },
    "allowedNextOperations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "authority": { "type": "object", "required": ["generatedBy", "hostAuthored", "hostMayRewrite", "businessViewIsApproval", "engineAuthoritative"], "properties": { "hostAuthored": { "const": false }, "hostMayRewrite": { "const": false }, "businessViewIsApproval": { "const": false }, "engineAuthoritative": { "const": true } } },
    "businessViewDigest": { "$ref": "#/$defs/digest" },
    "renderedBusinessViewDigest": { "$ref": "#/$defs/digest" },
    "canonicalMarkdown": { "type": "string", "minLength": 1 }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
