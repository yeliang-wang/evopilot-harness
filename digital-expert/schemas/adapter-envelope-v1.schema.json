{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/digital-expert-adapter-envelope-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "adapterId", "productVersion", "expertVersion", "coreDigest", "agentProtocolVersion", "engineApiVersion", "mcpCommand", "requiredCapabilities"],
  "properties": {
    "schema": { "const": "evopilot-harness-digital-expert-adapter/v1" },
    "adapterId": { "type": "string", "minLength": 1 },
    "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "expertVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "coreDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "agentProtocolVersion": { "const": "evopilot-harness-agent-operations/v2" },
    "engineApiVersion": { "const": "harness.evopilot.io/v3" },
    "mcpCommand": { "type": "string", "minLength": 1 },
    "requiredCapabilities": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
