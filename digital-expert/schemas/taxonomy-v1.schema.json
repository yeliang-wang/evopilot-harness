{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/taxonomy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "harness.evopilot.io/v1" },
    "kind": { "const": "Taxonomy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "version"],
      "properties": {
        "namespace": { "$ref": "#/$defs/namespace" },
        "name": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineRange", "requiredCapabilities", "axisPolicies", "domains", "products"],
      "properties": {
        "engineRange": { "type": "string", "minLength": 1, "maxLength": 64 },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "expectedCanonicalDigest": { "$ref": "#/$defs/digest" },
        "axisPolicies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domainCardinality", "productCardinality"],
          "properties": {
            "domainCardinality": { "enum": ["SINGLE", "MULTIPLE"] },
            "productCardinality": { "enum": ["SINGLE", "MULTIPLE"] }
          }
        },
        "domains": { "$ref": "#/$defs/nodes" },
        "products": { "$ref": "#/$defs/nodes" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 63 },
    "namespace": { "type": "string", "pattern": "^(?=[^.]{1,63}(?:\\.|$))[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.(?=[^.]{1,63}(?:\\.|$))[a-z0-9]+(?:-[a-z0-9]+)*)*$", "minLength": 1, "maxLength": 253 },
    "label": { "type": "string", "minLength": 1 },
    "definition": { "type": "string", "minLength": 1 },
    "hint": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/node" } },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "assignable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/label" },
        "aliases": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/label" } },
        "definition": { "$ref": "#/$defs/definition" },
        "parents": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "assignable": { "type": "boolean" },
        "positiveEvidenceHints": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/hint" } },
        "exclusionHints": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/hint" } }
      },
      "allOf": [
        {
          "if": { "properties": { "assignable": { "const": true } }, "required": ["assignable"] },
          "then": { "properties": { "definition": { "$ref": "#/$defs/definition" } }, "required": ["definition"] }
        }
      ]
    }
  }
}
