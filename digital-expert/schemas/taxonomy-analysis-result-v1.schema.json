{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/taxonomy-analysis-result-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "validation", "analysisAttemptDigest", "sourceDescriptor", "sourceDescriptorDigest", "sourceResolution", "sourceResolutionDigest", "sourceSnapshotDigest", "evidenceGraphDigest", "taxonomyDigest", "hypothesisDigest", "foundation", "resolvedTaxonomySnapshot", "sourceSnapshot", "evidenceGraph", "sourceConceptHypothesis", "retrieval", "advisor", "axes", "aggregate", "evolutionContext", "presentation", "authority", "nextOperations", "analysisResultDigest"],
  "properties": {
    "schema": { "const": "evopilot-harness-taxonomy-analysis-result/v1" },
    "validation": { "type": "object" },
    "analysisAttemptDigest": { "$ref": "#/$defs/digest" },
    "sourceDescriptor": { "type": ["object", "null"] },
    "sourceDescriptorDigest": { "$ref": "#/$defs/digest" },
    "sourceResolution": { "type": ["object", "null"] },
    "sourceResolutionDigest": { "$ref": "#/$defs/digest" },
    "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
    "evidenceGraphDigest": { "$ref": "#/$defs/digest" },
    "taxonomyDigest": { "$ref": "#/$defs/digest" },
    "hypothesisDigest": { "$ref": "#/$defs/digest" },
    "foundation": { "type": "object" },
    "resolvedTaxonomySnapshot": { "type": "object" },
    "sourceSnapshot": { "type": "object" },
    "evidenceGraph": { "type": "object" },
    "sourceConceptHypothesis": { "type": "object" },
    "retrieval": { "type": "object" },
    "advisor": { "type": "object" },
    "axes": { "type": "object", "required": ["domain", "product"] },
    "aggregate": { "enum": ["TAXONOMY_MATCHED", "TAXONOMY_EXTENSION_SUGGESTED", "TAXONOMY_EVIDENCE_INSUFFICIENT", "TAXONOMY_AMBIGUOUS"] },
    "evolutionContext": { "type": "object" },
    "presentation": { "type": "object" },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["engineDecides", "advisorMayDecide", "classificationProvesEligibility", "mayCreateProposal", "mayApprove", "mayPublish", "mayMutateTaxonomy"],
      "properties": {
        "engineDecides": { "const": true }, "advisorMayDecide": { "const": false }, "classificationProvesEligibility": { "const": false },
        "mayCreateProposal": { "const": false }, "mayApprove": { "const": false }, "mayPublish": { "const": false }, "mayMutateTaxonomy": { "const": false }
      }
    },
    "nextOperations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "analysisResultDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
