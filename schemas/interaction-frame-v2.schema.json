{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/interaction-frame-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "frameId", "stage", "createdAt", "sessionId", "sessionDigest", "compatibility", "subject", "requiredFields", "renderModel", "canonicalMarkdown", "businessView", "auditEnvelope", "decisionDefinition", "sourceReasoningMap", "decision", "allowedNextOperations", "forbiddenOperations", "authority", "redaction", "frameDigest"],
  "properties": {
    "schema": { "const": "evopilot-harness-interaction-frame/v2" },
    "frameId": { "type": "string", "pattern": "^frame-[a-z0-9-]{8,127}$" },
    "stage": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 6 },
    "sessionDigest": { "$ref": "#/$defs/digest" },
    "compatibility": { "type": "object" },
    "subject": { "type": "object", "required": ["type", "id", "digest", "bindings"], "properties": { "type": { "type": "string" }, "id": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" }, "bindings": { "type": "object" } } },
    "requiredFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "renderModel": { "type": "object" },
    "canonicalMarkdown": { "type": "string", "minLength": 1 },
    "businessView": { "type": "object", "required": ["schema", "businessViewDigest", "canonicalMarkdown"], "properties": { "schema": { "const": "evopilot-harness-business-decision-view/v1" }, "businessViewDigest": { "$ref": "#/$defs/digest" }, "canonicalMarkdown": { "type": "string" } } },
    "auditEnvelope": { "type": "object", "required": ["schema", "auditEnvelopeDigest"], "properties": { "schema": { "const": "evopilot-harness-compliance-audit-envelope/v1" }, "auditEnvelopeDigest": { "$ref": "#/$defs/digest" } } },
    "decisionDefinition": { "type": ["object", "null"] },
    "sourceReasoningMap": { "type": "object", "required": ["schema", "reasoningMapDigest"], "properties": { "schema": { "const": "evopilot-harness-source-to-harness-reasoning-map/v1" }, "reasoningMapDigest": { "$ref": "#/$defs/digest" } } },
    "decision": { "type": ["object", "null"] },
    "allowedNextOperations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "forbiddenOperations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "authority": { "type": "object", "required": ["engineAuthoritative", "presentationIsApproval", "automaticPublication", "hostMayRewriteBusinessView"], "properties": { "engineAuthoritative": { "const": true }, "presentationIsApproval": { "const": false }, "automaticPublication": { "const": false }, "hostMayRewriteBusinessView": { "const": false } } },
    "redaction": { "enum": ["SECRET_FREE", "REDACTED"] },
    "frameDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
