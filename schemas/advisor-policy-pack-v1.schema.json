{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/advisor-policy-pack-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "harness.evopilot.io/v1" },
    "kind": { "const": "AdvisorPolicyPack" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "lifecycle"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "lifecycle": { "enum": ["draft", "review", "approved", "published", "deprecated"] },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelConfigMode", "allowedProvider", "requiredCitations", "systemPrompt", "outputContract", "authority"],
      "properties": {
        "modelConfigMode": { "const": "manual-read-only" },
        "allowedProvider": { "const": "zhipu" },
        "requiredCitations": { "const": true },
        "systemPrompt": { "type": "string", "minLength": 40 },
        "reviewSystemPrompt": { "type": "string", "minLength": 40 },
        "outputContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredFields", "allowedRecommendations"],
          "properties": {
            "requiredFields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "allowedRecommendations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "evidenceProjection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "maxNodes", "maxCharacters", "maxExcerptCharacters"],
              "properties": {
                "algorithm": { "const": "reasoning-source-kind-round-robin/v1" },
                "maxNodes": { "type": "integer", "minimum": 1, "maximum": 128 },
                "maxCharacters": { "type": "integer", "minimum": 1000, "maximum": 250000 },
                "maxExcerptCharacters": { "type": "integer", "minimum": 100, "maximum": 8000 }
              }
            },
            "repair": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxAttempts", "retryOn"],
              "properties": {
                "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 1 },
                "retryOn": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["INVALID_RESPONSE_JSON", "CONTRACT_REJECTED"] }
                }
              }
            }
          }
        },
        "reviewContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredFields", "allowedVerdicts", "repair"],
          "properties": {
            "requiredFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "allowedVerdicts": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": { "enum": ["READY_FOR_HUMAN_APPROVAL", "REVISE", "SPLIT", "REJECT", "NEED_MORE_EVIDENCE"] }
            },
            "repair": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxAttempts", "retryOn"],
              "properties": {
                "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 1 },
                "retryOn": { "type": "array", "uniqueItems": true, "items": { "enum": ["INVALID_RESPONSE_JSON", "CONTRACT_REJECTED"] } }
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mayRecommend", "mayApprove", "mayPublish", "mayExecute", "mayMutateModelConfig"],
          "properties": {
            "mayRecommend": { "const": true },
            "mayApprove": { "const": false },
            "mayPublish": { "const": false },
            "mayExecute": { "const": false },
            "mayMutateModelConfig": { "const": false }
          }
        }
      }
    }
  }
}
