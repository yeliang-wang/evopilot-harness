{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/advisor-policy-pack-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "harness.evopilot.io/v1" },
    "kind": { "const": "AdvisorPolicyPack" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "lifecycle"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "lifecycle": { "enum": ["draft", "review", "approved", "published", "deprecated"] },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelConfigMode", "allowedProvider", "requiredCitations", "systemPrompt", "outputContract", "authority"],
      "properties": {
        "modelConfigMode": { "const": "manual-read-only" },
        "allowedProvider": { "const": "zhipu" },
        "requiredCitations": { "const": true },
        "systemPrompt": { "type": "string", "minLength": 40 },
        "outputContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredFields", "allowedRecommendations"],
          "properties": {
            "requiredFields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "allowedRecommendations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mayRecommend", "mayApprove", "mayPublish", "mayExecute", "mayMutateModelConfig"],
          "properties": {
            "mayRecommend": { "const": true },
            "mayApprove": { "const": false },
            "mayPublish": { "const": false },
            "mayExecute": { "const": false },
            "mayMutateModelConfig": { "const": false }
          }
        }
      }
    }
  }
}
