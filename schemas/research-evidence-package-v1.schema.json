{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.io/schemas/research-evidence-package-v1.schema.json",
  "title": "ResearchEvidencePackage v1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": { "const": "learning.evopilot.io/v1" },
    "kind": { "const": "ResearchEvidencePackage" },
    "metadata": {
      "type": "object",
      "required": ["version", "documentDigest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "documentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
