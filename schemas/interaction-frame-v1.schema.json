{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/interaction-frame-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "frameId", "stage", "createdAt", "sessionId", "sessionDigest", "compatibility", "subject", "requiredFields", "renderModel", "canonicalMarkdown", "decision", "allowedNextOperations", "forbiddenOperations", "authority", "redaction", "frameDigest"],
  "properties": {
    "schema": { "const": "evopilot-harness-interaction-frame/v1" },
    "frameId": { "type": "string", "pattern": "^frame-[a-z0-9-]{8,127}$" },
    "stage": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 6 },
    "sessionDigest": { "$ref": "#/$defs/digest" },
    "compatibility": { "type": "object", "additionalProperties": true },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "digest", "bindings"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "bindings": { "type": "object", "additionalProperties": true }
      }
    },
    "requiredFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "renderModel": { "type": "object", "additionalProperties": true },
    "canonicalMarkdown": { "type": "string", "minLength": 1 },
    "decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "question"]
    },
    "allowedNextOperations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "forbiddenOperations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineAuthoritative", "presentationIsApproval", "automaticPublication"],
      "properties": {
        "engineAuthoritative": { "const": true },
        "presentationIsApproval": { "const": false },
        "automaticPublication": { "const": false }
      }
    },
    "redaction": { "enum": ["SECRET_FREE", "REDACTED"] },
    "frameDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
