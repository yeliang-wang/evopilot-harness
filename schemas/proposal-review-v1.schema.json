{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/proposal-review-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "reviewId", "proposalId", "proposalDigest", "evidenceGraphDigest", "reasoningDigest",
    "reviewedAt", "status", "verdict", "summary", "findings", "reasons", "evidenceIds",
    "deterministicGates", "groupCoherence", "projectMembership", "boundaryAssessment",
    "existingAssetOverlap", "definitionQuality", "evaluationSufficiency", "advisorAssessment",
    "suggestedActions", "remainingBlockers", "reviewer", "algorithm", "humanDecisionRequired", "nextAction"
  ],
  "properties": {
    "schema": { "const": "evopilot-harness-proposal-review/v1" },
    "reviewId": { "type": "string", "minLength": 1 },
    "proposalId": { "type": "string", "minLength": 1 },
    "proposalDigest": { "$ref": "#/$defs/digest" },
    "evidenceGraphDigest": { "$ref": "#/$defs/digest" },
    "reasoningDigest": { "$ref": "#/$defs/digest" },
    "reviewedAt": { "type": "string", "minLength": 1 },
    "status": { "enum": ["REVIEWED", "ACTION_REQUIRED", "BLOCKED"] },
    "verdict": { "enum": ["READY_FOR_HUMAN_APPROVAL", "REVISE", "SPLIT", "REJECT", "NEED_MORE_EVIDENCE"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
    "deterministicGates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gate" } },
    "groupCoherence": { "$ref": "#/$defs/assessment" },
    "projectMembership": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/membership" } },
    "boundaryAssessment": { "$ref": "#/$defs/assessment" },
    "existingAssetOverlap": { "$ref": "#/$defs/overlap" },
    "definitionQuality": { "$ref": "#/$defs/quality" },
    "evaluationSufficiency": { "$ref": "#/$defs/assessment" },
    "advisorAssessment": { "$ref": "#/$defs/assessment" },
    "assetDeltaAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "deltaCount", "publicationAllowed", "checks"],
      "properties": {
        "status": { "enum": ["VALIDATED", "FAILED"] },
        "decision": { "type": "string", "minLength": 1 },
        "deltaCount": { "type": "integer", "minimum": 0 },
        "publicationAllowed": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/gate" } }
      }
    },
    "impactAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "readyCount", "blockedCount", "compatibility", "blastRadius", "rollback"],
      "properties": {
        "status": { "enum": ["READY", "BLOCKED", "NOT_APPLICABLE"] },
        "readyCount": { "type": "integer", "minimum": 0 },
        "blockedCount": { "type": "integer", "minimum": 0 },
        "compatibility": { "type": "array", "items": { "type": "string" } },
        "blastRadius": { "type": "array", "items": { "type": "string" } },
        "rollback": { "type": "array", "items": { "type": "string" } }
      }
    },
    "suggestedActions": { "type": "array", "items": { "type": "string" } },
    "remainingBlockers": { "type": "array", "items": { "type": "string" } },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policy", "usage", "attempts", "authority"],
      "properties": {
        "status": { "type": "string" },
        "requestId": { "type": "string" },
        "model": { "type": "object", "additionalProperties": true },
        "policy": {
          "type": "object",
          "additionalProperties": true,
          "required": ["id", "version", "digest"],
          "properties": {
            "id": { "type": "string" },
            "version": { "type": "string" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "usage": { "$ref": "#/$defs/usage" },
        "attempts": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "validation": { "type": "object", "additionalProperties": true },
        "evidenceProjection": { "type": "object", "additionalProperties": true },
        "resultPath": { "type": "string" },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mayReview", "mayApprove", "mayPublish", "mayExecute", "mayMutateModelConfig"],
          "properties": {
            "mayReview": { "const": true },
            "mayApprove": { "const": false },
            "mayPublish": { "const": false },
            "mayExecute": { "const": false },
            "mayMutateModelConfig": { "const": false }
          }
        }
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "deterministicDecision", "semanticVerdict"],
      "properties": {
        "version": { "enum": ["deterministic-gates-semantic-review-synthesis/v1", "deterministic-delta-gates-semantic-review-synthesis/v2"] },
        "deterministicDecision": { "type": "string" },
        "semanticVerdict": { "type": ["string", "null"] }
      }
    },
    "humanDecisionRequired": { "const": true },
    "nextAction": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^evidence-[0-9]{4,}$" } },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "dimension", "conclusion", "reasons", "evidenceIds", "suggestedActions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "blocking"] },
        "dimension": { "type": "string", "minLength": 1 },
        "conclusion": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "suggestedActions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "blocking", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL"] },
        "blocking": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceType", "sourceRef", "status", "rationale", "evidenceIds"],
      "properties": {
        "sourceId": { "type": "string" },
        "sourceType": { "type": "string" },
        "sourceRef": { "type": "string" },
        "status": { "enum": ["IN_SCOPE", "OUT_OF_SCOPE", "UNCERTAIN"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "overlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "candidates", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score", "rationale", "checks", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "totalTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
