{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/professional-pack-inspection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pack", "lint", "dependencies", "compatibility", "authority", "inspectionDigest"],
  "properties": {
    "schema": {"const": "evopilot-harness-professional-pack-inspection/v1"},
    "pack": {"type": "object"},
    "lint": {"type": "object"},
    "dependencies": {"type": "array"},
    "compatibility": {"type": "object"},
    "authority": {"type": "object"},
    "inspectionDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
