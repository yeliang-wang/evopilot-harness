{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/github-discovery-selection-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "waveId", "targetVersion", "candidate", "planDigest", "fixedWaveReportDigest", "firstSearchResponseAt", "frozenAt", "freshnessMinutes", "searchCaptures", "rejectionLedger", "repositories", "diversity", "candidateIsolation", "authority", "selectionManifestDigest"],
  "properties": {
    "schema": { "const": "evopilot-harness-github-discovery-selection-manifest/v1" },
    "status": { "const": "FROZEN_AWAITING_ORACLE" },
    "waveId": { "type": "string" },
    "targetVersion": { "type": "string" },
    "candidate": { "type": "object" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "fixedWaveReportDigest": { "$ref": "#/$defs/digest" },
    "firstSearchResponseAt": { "type": "string" },
    "frozenAt": { "type": "string" },
    "freshnessMinutes": { "type": "number", "minimum": 0, "maximum": 60 },
    "searchCaptures": { "type": "array", "minItems": 1 },
    "rejectionLedger": { "type": "array" },
    "repositories": { "type": "array", "minItems": 1, "maxItems": 12 },
    "diversity": { "type": "object" },
    "candidateIsolation": { "type": "object" },
    "authority": { "type": "object" },
    "selectionManifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
