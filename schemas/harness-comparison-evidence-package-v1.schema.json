{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.io/schemas/harness-comparison-evidence-package-v1.schema.json",
  "title": "Harness Comparison Evidence Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "approval", "redaction", "baseline", "candidate", "comparisonContext", "metricDefinitions", "observations", "provenance"],
  "properties": {
    "apiVersion": { "const": "comparison.evopilot.io/v1" },
    "kind": { "const": "HarnessComparisonEvidencePackage" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparisonId", "packageId", "version", "generatedAt", "expiresAt", "producer", "packageDigest"],
      "properties": {
        "comparisonId": { "$ref": "#/$defs/identifier" },
        "packageId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "instanceId"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "instanceId": { "type": "string", "minLength": 1 }
          }
        },
        "packageDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedBy", "approvedAt", "purpose"],
      "properties": {
        "status": { "const": "APPROVED" },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "$ref": "#/$defs/timestamp" },
        "purpose": { "const": "HARNESS_COMPARISON_EVIDENCE" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "payloadDigest"],
      "properties": {
        "status": { "const": "REDACTED" },
        "method": { "type": "string", "minLength": 1 },
        "payloadDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "baseline": { "$ref": "#/$defs/assetBinding" },
    "candidate": { "$ref": "#/$defs/assetBinding" },
    "comparisonContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "sourceSnapshotDigest", "environmentDigest", "modelConfigurationDigest", "toolchainDigest", "evaluationPackRef", "scorerSet"],
      "properties": {
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
        "environmentDigest": { "$ref": "#/$defs/digest" },
        "modelConfigurationDigest": { "$ref": "#/$defs/digest" },
        "toolchainDigest": { "$ref": "#/$defs/digest" },
        "evaluationPackRef": { "$ref": "#/$defs/reference" },
        "scorerSet": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "metricDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "valueType", "direction", "required", "blocking", "minimumMeaningfulDelta", "maximumAllowedRegression"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "dimension": { "enum": ["OUTCOME", "PROCESS", "SAFETY", "COST"] },
          "valueType": { "enum": ["BOOLEAN", "NUMBER"] },
          "direction": { "enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER", "TRUE_IS_BETTER"] },
          "unit": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "blocking": { "type": "boolean" },
          "minimumMeaningfulDelta": { "type": "number", "minimum": 0 },
          "maximumAllowedRegression": { "type": "number", "minimum": 0 }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pairId", "baseline", "candidate"],
        "properties": {
          "pairId": { "$ref": "#/$defs/identifier" },
          "baseline": { "$ref": "#/$defs/executionResult" },
          "candidate": { "$ref": "#/$defs/executionResult" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceType", "generatedBy", "evidenceDigests"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/identifier" },
        "sourceType": { "enum": ["EVOPILOT", "CI", "EVALUATOR", "OPERATOR_IMPORT", "OTHER"] },
        "generatedBy": { "type": "string", "minLength": 1 },
        "evidenceDigests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "digest"],
      "properties": {
        "kind": { "enum": ["HarnessComponent", "HarnessProfile", "HarnessBundle", "OntologyPack", "MatchPolicyPack", "AdvisorPolicyPack", "ComparisonPolicyPack", "EvaluationPack"] },
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "proposalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "proposalDigest"],
      "properties": {
        "proposalId": { "$ref": "#/$defs/identifier" },
        "proposalDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "assetRefs"],
      "properties": {
        "source": { "enum": ["CATALOG", "PROPOSAL"] },
        "assetRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assetReference" }
        },
        "proposalRef": { "$ref": "#/$defs/proposalReference" }
      }
    },
    "metricObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "status"],
      "properties": {
        "metricId": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["OBSERVED", "MISSING", "ERROR"] },
        "value": { "oneOf": [{ "type": "boolean" }, { "type": "number" }] },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "executionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionId", "completedAt", "metrics"],
      "properties": {
        "executionId": { "$ref": "#/$defs/identifier" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metricObservation" }
        }
      }
    }
  }
}
