{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/evaluation-pack-v2.schema.json",
  "title": "Evaluation Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "harness.evopilot.io/v2" },
    "kind": { "const": "EvaluationPack" },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "lifecycle"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["draft", "review", "approved", "published", "deprecated"] },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["targetRef", "minimumReviewedCases", "requiredDimensions", "criteria", "cases", "status"],
      "properties": {
        "targetRef": { "$ref": "#/$defs/assetRef" },
        "minimumReviewedCases": { "type": "integer", "minimum": 1 },
        "requiredDimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["outcome", "process", "safety", "cost"] } },
        "criteria": {
          "type": "object", "additionalProperties": false,
          "required": ["outcome", "process", "safety", "cost"],
          "properties": {
            "outcome": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "minimumSuccessRate": { "$ref": "#/$defs/ratio" }, "minimumAverageScore": { "$ref": "#/$defs/ratio" } } },
            "process": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "maximumFailureRate": { "$ref": "#/$defs/ratio" }, "maximumAverageRetryCount": { "type": "number", "minimum": 0 }, "maximumAverageDurationMs": { "type": "number", "minimum": 0 } } },
            "safety": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "minimumSafeRate": { "$ref": "#/$defs/ratio" }, "maximumIncidentCount": { "type": "integer", "minimum": 0 } } },
            "cost": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "maximumAverageTotalTokens": { "type": "number", "minimum": 0 }, "maximumAverageEstimatedCost": { "type": "number", "minimum": 0 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } } }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "inputDigest", "expectedDecision", "reviewStatus", "feedbackPackageRefs"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "inputDigest": { "$ref": "#/$defs/digest" },
              "expectedDecision": { "type": "string", "minLength": 1 },
              "reviewStatus": { "enum": ["unreviewed", "approved", "rejected"] },
              "feedbackPackageRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/packageRef" } }
            }
          }
        },
        "status": { "enum": ["INSUFFICIENT_EVAL_EVIDENCE", "READY", "FAILED"] }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "assetRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "version", "digest"],
      "properties": { "kind": { "enum": ["HarnessComponent", "HarnessProfile", "HarnessBundle"] }, "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "packageRef": {
      "type": "object", "additionalProperties": false,
      "required": ["packageId", "version", "digest"],
      "properties": { "packageId": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }
    }
  }
}
