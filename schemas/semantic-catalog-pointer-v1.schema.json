{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/semantic-catalog-pointer-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalogId",
    "generationPath",
    "generationDigest",
    "previousPointerDigest",
    "receiptDigest",
    "pointerDigest"
  ],
  "properties": {
    "schema": {
      "const": "evopilot-harness-semantic-catalog-pointer/v1"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "generationPath": {
      "type": "string",
      "pattern": "^semantic-catalog/generations/[a-f0-9]{64}\\.json$"
    },
    "generationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "previousPointerDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "pointerDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
