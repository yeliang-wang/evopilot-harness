{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/proposal-semantic-review-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "reasons", "groupCoherence", "projectMembership", "boundaryAssessment", "existingAssetOverlap", "definitionQuality", "evaluationSufficiency", "advisorAssessment", "suggestedActions"],
  "properties": {
    "verdict": { "enum": ["READY_FOR_HUMAN_APPROVAL", "REVISE", "SPLIT", "REJECT", "NEED_MORE_EVIDENCE"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "groupCoherence": { "$ref": "#/$defs/assessment" },
    "projectMembership": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/membership" } },
    "boundaryAssessment": { "$ref": "#/$defs/assessment" },
    "existingAssetOverlap": { "$ref": "#/$defs/overlap" },
    "definitionQuality": { "$ref": "#/$defs/quality" },
    "evaluationSufficiency": { "$ref": "#/$defs/assessment" },
    "advisorAssessment": { "$ref": "#/$defs/assessment" },
    "suggestedActions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^evidence-[0-9]{4,}$" } },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "dimension", "conclusion", "reasons", "evidenceIds", "suggestedActions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "blocking"] },
        "dimension": { "type": "string", "minLength": 1 },
        "conclusion": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "suggestedActions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceType", "sourceRef", "sourceDigest", "status", "rationale", "evidenceIds"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceType": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": { "enum": ["IN_SCOPE", "OUT_OF_SCOPE", "UNCERTAIN"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "overlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "candidates", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score", "rationale", "checks", "evidenceIds"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    }
  }
}
