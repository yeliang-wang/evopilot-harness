{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/harness-execution-feedback-package-v1.schema.json",
  "title": "Harness Execution Feedback Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "approval", "redaction", "harnessBinding", "executionContext", "dimensions", "provenance"],
  "properties": {
    "apiVersion": { "const": "feedback.evopilot.io/v1" },
    "kind": { "const": "HarnessExecutionFeedbackPackage" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "version", "generatedAt", "expiresAt", "producer", "packageDigest"],
      "properties": {
        "packageId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semver" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "instanceId"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "instanceId": { "type": "string", "minLength": 1 }
          }
        },
        "packageDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedBy", "approvedAt", "purpose"],
      "properties": {
        "status": { "const": "APPROVED" },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "$ref": "#/$defs/timestamp" },
        "purpose": { "type": "string", "minLength": 8 }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policyVersion", "removedFieldCount", "payloadDigest"],
      "properties": {
        "status": { "const": "REDACTED" },
        "policyVersion": { "type": "string", "minLength": 1 },
        "removedFieldCount": { "type": "integer", "minimum": 0 },
        "payloadDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "harnessBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleRef", "profileRef", "componentRefs"],
      "properties": {
        "bundleRef": { "$ref": "#/$defs/assetRef" },
        "profileRef": { "$ref": "#/$defs/assetRef" },
        "componentRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assetRef" }
        }
      }
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskClass", "complexity", "environmentDigest", "trajectoryRefs"],
      "properties": {
        "taskClass": { "type": "string", "minLength": 1 },
        "complexity": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
        "environmentDigest": { "$ref": "#/$defs/digest" },
        "trajectoryRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" }
      },
      "dependentRequired": { "startedAt": ["completedAt"], "completedAt": ["startedAt"] }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "process", "safety", "cost"],
      "properties": {
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["SUCCEEDED", "PARTIAL", "FAILED"] },
            "score": { "$ref": "#/$defs/ratio" },
            "acceptancePassed": { "type": "integer", "minimum": 0 },
            "acceptanceTotal": { "type": "integer", "minimum": 0 }
          },
          "dependentRequired": { "acceptancePassed": ["acceptanceTotal"], "acceptanceTotal": ["acceptancePassed"] }
        },
        "process": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["COMPLETED", "DEGRADED", "FAILED"] },
            "stepCount": { "type": "integer", "minimum": 0 },
            "failedStepCount": { "type": "integer", "minimum": 0 },
            "retryCount": { "type": "integer", "minimum": 0 },
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["SAFE", "POLICY_VIOLATION", "INCIDENT"] },
            "violationCount": { "type": "integer", "minimum": 0 },
            "incidentCount": { "type": "integer", "minimum": 0 }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["RECORDED", "UNAVAILABLE"] },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "totalTokens": { "type": "integer", "minimum": 0 },
            "estimatedCost": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          },
          "dependentRequired": { "estimatedCost": ["currency"], "currency": ["estimatedCost"] },
          "allOf": [{
            "if": { "properties": { "status": { "const": "RECORDED" } }, "required": ["status"] },
            "then": {
              "properties": { "totalTokens": { "type": "integer", "minimum": 0 } },
              "required": ["totalTokens"]
            }
          }]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "sourceId", "requestIds", "model", "evidenceRefs"],
      "properties": {
        "sourceType": { "enum": ["evopilot-goal-loop", "control-plane-export", "reviewed-external-execution"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "requestIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "name"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
