{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/pack-gold-case-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "source", "expectedConcepts", "expectedOutcome", "provenance", "evidenceRefs", "authority", "goldCaseDigest"],
  "properties": {
    "schema": {"const": "evopilot-harness-pack-gold-case/v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source": {"type": "object"},
    "expectedConcepts": {"type": "array", "items": {"type": "string"}},
    "expectedOutcome": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "object"},
    "goldCaseDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
