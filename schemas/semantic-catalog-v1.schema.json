{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/semantic-catalog-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalogId",
    "entries",
    "revokedDigests",
    "generationDigest"
  ],
  "properties": {
    "schema": {
      "const": "evopilot-harness-semantic-catalog/v1"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "version",
          "schema",
          "objectDigest",
          "fileDigest",
          "bytes",
          "path",
          "scope",
          "visibility",
          "provenance",
          "parent",
          "dependencies"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "ASSET",
              "DEPENDENCY"
            ]
          },
          "objectDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "fileDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "path": {
            "type": "string",
            "pattern": "^semantic-catalog/materials/[a-f0-9]{64}\\.json$"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tenantId",
              "workspaceId",
              "projectId"
            ],
            "properties": {
              "tenantId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              },
              "workspaceId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              },
              "projectId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              }
            }
          },
          "visibility": {
            "enum": [
              "PUBLIC",
              "DOMAIN",
              "PRIVATE"
            ]
          },
          "provenance": {
            "type": "object"
          },
          "publication": {
            "type": [
              "object",
              "null"
            ]
          },
          "parent": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifactSetDigest",
                  "jsonPointer"
                ],
                "properties": {
                  "artifactSetDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "jsonPointer": {
                    "const": "/spec/projectOntologySkill"
                  }
                }
              }
            ]
          },
          "dependencies": {
            "type": "array",
            "maxItems": 16384,
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "revokedDigests": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "generationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sets": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "refs"
        ],
        "properties": {
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tenantId",
              "workspaceId",
              "projectId"
            ],
            "properties": {
              "tenantId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              },
              "workspaceId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              },
              "projectId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
              }
            }
          },
          "refs": {
            "type": "object"
          }
        }
      }
    }
  }
}
