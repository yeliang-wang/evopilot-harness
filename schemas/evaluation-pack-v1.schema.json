{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/evaluation-pack-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "harness.evopilot.io/v1" },
    "kind": { "const": "EvaluationPack" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "lifecycle"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "lifecycle": { "enum": ["draft", "review", "approved", "published", "deprecated"] },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "minimumReviewedCases", "cases", "status"],
      "properties": {
        "targetRef": { "type": "string" },
        "minimumReviewedCases": { "type": "integer", "minimum": 1 },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "inputDigest", "expectedDecision", "reviewStatus"],
            "properties": {
              "id": { "type": "string" },
              "inputDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "expectedDecision": { "type": "string" },
              "reviewStatus": { "enum": ["unreviewed", "approved", "rejected"] }
            }
          }
        },
        "status": { "enum": ["INSUFFICIENT_EVAL_EVIDENCE", "READY", "FAILED"] }
      }
    }
  }
}
