{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evopilot.dev/schemas/harness-effectiveness-report-v1.schema.json",
  "title": "Harness Effectiveness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "scope", "summary", "groups"],
  "properties": {
    "apiVersion": { "const": "feedback.evopilot.io/v1" },
    "kind": { "const": "HarnessEffectivenessReport" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "generatedAt", "algorithmVersion", "reportDigest"],
      "properties": {
        "reportId": { "type": "string", "minLength": 1 },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "algorithmVersion": { "const": "effectiveness-aggregate/v1" },
        "reportDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageCount", "packageDigests"],
      "properties": {
        "packageCount": { "type": "integer", "minimum": 0 },
        "packageDigests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
      }
    },
    "summary": { "$ref": "#/$defs/aggregate" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetRef", "aggregate"],
        "properties": {
          "assetRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "version", "digest"],
            "properties": {
              "kind": { "enum": ["HarnessBundle", "HarnessProfile", "HarnessComponent"] },
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          },
          "aggregate": { "$ref": "#/$defs/aggregate" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$" },
    "statusCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "optionalNumber": { "type": ["number", "null"] },
    "interval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleCount", "independentSourceCount", "contexts", "missingFields", "dimensions", "uncertainty"],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 0 },
        "independentSourceCount": { "type": "integer", "minimum": 0 },
        "contexts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskClasses", "complexities", "environmentDigests"],
          "properties": {
            "taskClasses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "complexities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "environmentDigests": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "uniqueItems": true }
          }
        },
        "missingFields": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "process", "safety", "cost"],
          "properties": {
            "outcome": {
              "type": "object", "additionalProperties": false,
              "required": ["statusCounts", "successRate", "averageScore"],
              "properties": { "statusCounts": { "$ref": "#/$defs/statusCounts" }, "successRate": { "$ref": "#/$defs/optionalNumber" }, "averageScore": { "$ref": "#/$defs/optionalNumber" } }
            },
            "process": {
              "type": "object", "additionalProperties": false,
              "required": ["statusCounts", "averageStepCount", "averageRetryCount", "averageDurationMs"],
              "properties": { "statusCounts": { "$ref": "#/$defs/statusCounts" }, "averageStepCount": { "$ref": "#/$defs/optionalNumber" }, "averageRetryCount": { "$ref": "#/$defs/optionalNumber" }, "averageDurationMs": { "$ref": "#/$defs/optionalNumber" } }
            },
            "safety": {
              "type": "object", "additionalProperties": false,
              "required": ["statusCounts", "safeRate", "violationCount", "incidentCount"],
              "properties": { "statusCounts": { "$ref": "#/$defs/statusCounts" }, "safeRate": { "$ref": "#/$defs/optionalNumber" }, "violationCount": { "type": "integer", "minimum": 0 }, "incidentCount": { "type": "integer", "minimum": 0 } }
            },
            "cost": {
              "type": "object", "additionalProperties": false,
              "required": ["statusCounts", "averageInputTokens", "averageOutputTokens", "averageTotalTokens", "averageEstimatedCost", "estimatedCostByCurrency", "currencies"],
              "properties": {
                "statusCounts": { "$ref": "#/$defs/statusCounts" },
                "averageInputTokens": { "$ref": "#/$defs/optionalNumber" },
                "averageOutputTokens": { "$ref": "#/$defs/optionalNumber" },
                "averageTotalTokens": { "$ref": "#/$defs/optionalNumber" },
                "averageEstimatedCost": { "$ref": "#/$defs/optionalNumber" },
                "estimatedCostByCurrency": {
                  "type": "array",
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["currency", "sampleCount", "averageEstimatedCost"],
                    "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "sampleCount": { "type": "integer", "minimum": 1 }, "averageEstimatedCost": { "type": "number", "minimum": 0 } }
                  }
                },
                "currencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              }
            }
          }
        },
        "uncertainty": {
          "type": "object", "additionalProperties": false,
          "required": ["level", "reasons", "outcomeSuccessRate95", "safetySafeRate95"],
          "properties": {
            "level": { "enum": ["LOW", "MEDIUM", "HIGH"] },
            "reasons": { "type": "array", "items": { "type": "string" } },
            "outcomeSuccessRate95": { "$ref": "#/$defs/interval" },
            "safetySafeRate95": { "$ref": "#/$defs/interval" }
          }
        }
      }
    }
  }
}
