{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evopilot:online:openslo-v1:profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "openslo/v1"
    },
    "kind": {
      "const": "SLO"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "indicator",
        "timeWindow",
        "budgetingMethod",
        "objectives"
      ],
      "properties": {
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "indicator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadata",
            "spec"
          ],
          "properties": {
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
                }
              }
            },
            "spec": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ratioMetric"
              ],
              "properties": {
                "ratioMetric": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "good",
                    "total"
                  ],
                  "properties": {
                    "good": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "metricSource"
                      ],
                      "properties": {
                        "metricSource": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "spec"
                          ],
                          "properties": {
                            "type": {
                              "const": "Prometheus"
                            },
                            "spec": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "query",
                                "freshnessQuery",
                                "unit"
                              ],
                              "properties": {
                                "query": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048,
                                  "pattern": "^[^\\u0000-\\u001f]+$"
                                },
                                "freshnessQuery": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048,
                                  "pattern": "^[^\\u0000-\\u001f]+$"
                                },
                                "unit": {
                                  "enum": [
                                    "events",
                                    "events_per_second"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "total": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "metricSource"
                      ],
                      "properties": {
                        "metricSource": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "spec"
                          ],
                          "properties": {
                            "type": {
                              "const": "Prometheus"
                            },
                            "spec": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "query",
                                "freshnessQuery",
                                "unit"
                              ],
                              "properties": {
                                "query": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048,
                                  "pattern": "^[^\\u0000-\\u001f]+$"
                                },
                                "freshnessQuery": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 2048,
                                  "pattern": "^[^\\u0000-\\u001f]+$"
                                },
                                "unit": {
                                  "enum": [
                                    "events",
                                    "events_per_second"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "timeWindow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "duration",
              "isRolling"
            ],
            "properties": {
              "duration": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(s|m|h|d|w)$"
              },
              "isRolling": {
                "const": true
              }
            }
          }
        },
        "budgetingMethod": {
          "const": "RatioTimeslices"
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "timeSliceWindow"
            ],
            "properties": {
              "target": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              },
              "timeSliceWindow": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(s|m|h|d|w)$"
              }
            }
          }
        }
      }
    }
  }
}
