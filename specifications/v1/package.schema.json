{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evopilot:harness:v1:package",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "evopilot-native-package/v1"
        },
        "specVersion": {
          "const": "v1"
        },
        "owner": {
          "const": "harness"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$|^[^\\s\\u0000-\\u001f\\u007f]$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "standardPins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "standardDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "standardLockDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "standardDigest",
            "standardLockDigest"
          ]
        },
        "contractDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product": {
              "const": "harness"
            },
            "version": {
              "const": "0.3.0"
            }
          },
          "required": [
            "product",
            "version"
          ]
        },
        "entrypoints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$|^[^\\s\\u0000-\\u001f\\u007f]$"
              }
            },
            "tests": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$|^[^\\s\\u0000-\\u001f\\u007f]$"
              }
            },
            "data": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$|^[^\\s\\u0000-\\u001f\\u007f]$"
              }
            },
            "config": {
              "const": "conftest.toml"
            },
            "ruleCatalog": {
              "const": "rule-catalog.json"
            },
            "coverage": {
              "const": "coverage.json"
            },
            "parameterSchema": {
              "const": "parameter-schema.json"
            },
            "observation": {
              "const": "observations/current.json"
            }
          },
          "required": [
            "policy",
            "tests",
            "data",
            "config",
            "ruleCatalog",
            "coverage",
            "parameterSchema",
            "observation"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))(?!.*//)(?!.*[. ](?:/|$))[^\\u0000-\\u001f\\u007f]+$"
              },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$|^[^\\s\\u0000-\\u001f\\u007f]$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "mediaType",
              "sha256"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "product": {
                    "const": "harness"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$|^[^\\s\\u0000-\\u001f\\u007f]$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                  },
                  "specVersion": {
                    "const": "v1"
                  },
                  "visibility": {
                    "enum": [
                      "public",
                      "private"
                    ]
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "standardDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "standardLockDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "producer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "product": {
                        "const": "harness"
                      },
                      "version": {
                        "const": "0.3.0"
                      }
                    },
                    "required": [
                      "product",
                      "version"
                    ]
                  },
                  "contractDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "product",
                  "id",
                  "version",
                  "specVersion",
                  "visibility",
                  "digest",
                  "standardDigest",
                  "standardLockDigest",
                  "producer",
                  "contractDigest"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "product": {
                    "const": "ontology"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f]).*\\S$|^[^\\s\\u0000-\\u001f\\u007f]$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                  },
                  "specVersion": {
                    "const": "v1"
                  },
                  "visibility": {
                    "enum": [
                      "public",
                      "private"
                    ]
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "standardDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "standardLockDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "producer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "product": {
                        "const": "ontology"
                      },
                      "version": {
                        "const": "0.3.0"
                      }
                    },
                    "required": [
                      "product",
                      "version"
                    ]
                  },
                  "contractDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "product",
                  "id",
                  "version",
                  "specVersion",
                  "visibility",
                  "digest",
                  "standardDigest",
                  "standardLockDigest",
                  "producer",
                  "contractDigest"
                ]
              }
            ]
          }
        },
        "sourceBindingRef": {
          "const": "source-bindings.json"
        }
      },
      "required": [
        "schema",
        "specVersion",
        "owner",
        "id",
        "version",
        "visibility",
        "standardPins",
        "contractDigest",
        "producer",
        "entrypoints",
        "files",
        "dependencies",
        "sourceBindingRef"
      ]
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)(?:\\.\\.?)(?:/|$))(?!.*//)(?!.*[. ](?:/|$))[^\\u0000-\\u001f\\u007f]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "manifest",
    "files"
  ]
}
